<file path="src-ts-backup/lib/api/http.ts">
import { CONFIG } from "@config";
// COMMENT-TO-REPLACE
export class ApiError extends Error {
  status: number;
  body: unknown;
// COMMENT-TO-REPLACE
  constructor(message: string, status: number, body?: unknown) {
    super(message);
    this.name = "ApiError";
    this.status = status;
    this.body = body;
  }
}
// COMMENT-TO-REPLACE
interface ApiFetchOptions extends Omit<RequestInit, "body"> {
  /** Attach the Bearer token from localStorage. Defaults to true. */
  auth?: boolean;
  /** JSON-serializable request body. */
  body?: unknown;
}
// COMMENT-TO-REPLACE
function getToken(): string | null {
  return localStorage.getItem("token");
}
// COMMENT-TO-REPLACE
/**
 * Thin fetch wrapper shared by every feature's API layer.
 *
 * - Prefixes CONFIG.API_BASE_URL
 * - Attaches `Authorization: Bearer <token>` unless `auth: false`
 * - Serializes/deserializes JSON automatically
 * - Throws ApiError with the backend's `message` on non-2xx responses
 */
export async function apiFetch<T = unknown>(
  path: string,
  options: ApiFetchOptions = {},
): Promise<T> {
  const { auth = true, headers, body, ...rest } = options;
// COMMENT-TO-REPLACE
  const finalHeaders: Record<string, string> = {
    ...(headers as Record<string, string> | undefined),
  };
// COMMENT-TO-REPLACE
  let finalBody: BodyInit | undefined;
// COMMENT-TO-REPLACE
  if (body !== undefined) {
    finalHeaders["Content-Type"] = "application/json";
    finalBody = JSON.stringify(body);
  }
// COMMENT-TO-REPLACE
  if (auth) {
    const token = getToken();
    if (token) {
      finalHeaders["Authorization"] = `Bearer ${token}`;
    }
  }
// COMMENT-TO-REPLACE
  const response = await fetch(`${CONFIG.API_BASE_URL}${path}`, {
    ...rest,
    headers: finalHeaders,
    body: finalBody,
  });
// COMMENT-TO-REPLACE
  const text = await response.text();
  const data = text ? JSON.parse(text) : {};
// COMMENT-TO-REPLACE
  if (!response.ok) {
    const message =
      (data && (data.message || data.error)) ||
      `Request failed (${response.status})`;
    throw new ApiError(message, response.status, data);
  }
// COMMENT-TO-REPLACE
  return data as T;
}
// COMMENT-TO-REPLACE
/** Fetch a binary response (e.g. a generated PDF) and return it as a Blob. */
export async function apiFetchBlob(
  path: string,
  options: ApiFetchOptions = {},
): Promise<Blob> {
  const { auth = true, headers, body: _body, ...rest } = options;
  void _body;
// COMMENT-TO-REPLACE
  const finalHeaders: Record<string, string> = {
    ...(headers as Record<string, string> | undefined),
  };
// COMMENT-TO-REPLACE
  if (auth) {
    const token = getToken();
    if (token) {
      finalHeaders["Authorization"] = `Bearer ${token}`;
    }
  }
// COMMENT-TO-REPLACE
  const response = await fetch(`${CONFIG.API_BASE_URL}${path}`, {
    ...rest,
    headers: finalHeaders,
  });
// COMMENT-TO-REPLACE
  if (!response.ok) {
    let message = `Request failed (${response.status})`;
    try {
      const data = JSON.parse(await response.text());
      message = data?.message || message;
    } catch {
      // response wasn't JSON — keep the generic message
    }
    throw new ApiError(message, response.status);
  }
// COMMENT-TO-REPLACE
  return response.blob();
}
// COMMENT-TO-REPLACE
export function downloadBlob(blob: Blob, fileName: string) {
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  link.remove();
  URL.revokeObjectURL(url);
}
// COMMENT-TO-REPLACE
</file>

