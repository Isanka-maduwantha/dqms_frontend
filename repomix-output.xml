            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </FormSelect>
        </div>
        <FormInput label="Address (optional)" value={form.address} onChange={(e) => setForm((f) => ({ ...f, address: e.target.value }))}/>
        <div className="pt-4">
          <CommonButton type="submit" disabled={saving} label={saving ? "Registering…" : "Generate walk-in token"} className="text-[13px] py-2.5"/>
        </div>
      </form>
    </Card>);
