function ProtectedRoute({userRole, allowedRoles} : ProtectedRouteProps) : ReactElement {
    const isAuthorized = userRole ? allowedRoles.includes(userRole) : false;
// COMMENT-TO-REPLACE
    if(!isAuthorized) {
        return <Navigate to="/unauthorized" replace />
    }
  return (
    <Outlet/>
  )
}
