                formatCurrency(inv.amountPaid),
                <StatusBadge status={inv.status} />,
              ])}
            />
          )}
        </Card>
      </div>
    );
  }
// COMMENT-TO-REPLACE
  if (tab === "payments") {
    return (
      <div className="flex flex-col gap-5">
