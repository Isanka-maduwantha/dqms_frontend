            </h4>
            <select style={{ fontSize: "12px" }} id="type" className="block w-full  p-2 text-sm  outline-none border font-inter border-border-grey rounded-2xl" value={type} onChange={(e) => {
            setType(e.target.value);
        }}>
              <option value="CHECKUP">Checkup</option>
              <option value="NEW_PATIENT">New patient</option>
              <option value="EMERGENCY">Emergency</option>
              <option value="OTHER">Other</option>
            </select>
            <FormSelect label="Visit purpose" padding="0" value={visitPurpose} onChange={(e) => setVisitPurpose(e.target.value)}>
              {VISIT_PURPOSES.map((p) => (<option key={p.value} value={p.value}>
                  {p.label}
                </option>))}
            </FormSelect>
            <p className="text-[11px] text-muted-green">
              {VISIT_PURPOSES.find((p) => p.value === visitPurpose)?.hint}
            </p>
          </div>
        </div>
        <div className="col-span-3 avaliable-slots-container p-5 pb-14 border border-border-grey rounded-[14px] min-w-3/6">
          <h3 className="font-manrope text-sm font-bold text-green-text-1">
