<file path="src-ts-backup/features/auth/services/authApi.ts">
import { apiFetch } from "../../../lib/api/http";
// COMMENT-TO-REPLACE
export interface LoginPayload {
  email: string;
  password: string;
}
// COMMENT-TO-REPLACE
export interface RegisterPayload {
  name: string;
  nic: string;
  phone: string;
  email: string;
  password: string;
}
// COMMENT-TO-REPLACE
export interface AuthUser {
  id: string;
  name?: string;
  email: string;
  role: "patient" | "admin" | "dentist" | "receptionist";
}
// COMMENT-TO-REPLACE
interface AuthResponse {
  message: string;
  token: string;
  user: AuthUser;
}
// COMMENT-TO-REPLACE
export async function loginUser(payload: LoginPayload) {
  return apiFetch<AuthResponse>("/api/auth/login", {
    method: "POST",
    body: payload,
    auth: false,
  });
}
// COMMENT-TO-REPLACE
export async function adminLogin(payload: LoginPayload) {
  return apiFetch<AuthResponse>("/api/admin/login", {
    method: "POST",
    body: payload,
    auth: false,
  });
}
// COMMENT-TO-REPLACE
export async function registerUser(payload: RegisterPayload) {
  return apiFetch<{ message: string; user: AuthUser }>("/api/auth/register", {
    method: "POST",
    body: payload,
    auth: false,
  });
}
// COMMENT-TO-REPLACE
/** Persist the session after a successful login. */
export function saveSession(token: string, user: AuthUser) {
  localStorage.setItem("token", token);
  localStorage.setItem("user", JSON.stringify(user));
}
// COMMENT-TO-REPLACE
export function saveToken(token: string) {
  localStorage.setItem("token", token);
}
// COMMENT-TO-REPLACE
export function clearSession() {
  localStorage.removeItem("token");
  localStorage.removeItem("user");
}
// COMMENT-TO-REPLACE
function decodeBase64Url(base64Url: string) {
  const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
  const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), "=");
  return atob(padded);
}
// COMMENT-TO-REPLACE
export function getUserFromToken(): { id?: string; email?: string; role?: string } | null {
  const token = localStorage.getItem("token");
  if (!token) return null;
// COMMENT-TO-REPLACE
  try {
    const payload = token.split(".")[1];
    const decoded = decodeBase64Url(payload);
    return JSON.parse(decoded);
  } catch (error) {
    console.error("Failed to parse token", error);
    return null;
  }
}
// COMMENT-TO-REPLACE
/** Cached display info saved at login time (has `name`, unlike the raw JWT). */
export function getStoredUser(): AuthUser | null {
  const raw = localStorage.getItem("user");
  if (!raw) return null;
// COMMENT-TO-REPLACE
  try {
    return JSON.parse(raw) as AuthUser;
  } catch {
    return null;
  }
}
// COMMENT-TO-REPLACE
export function getRole() {
  const user = getUserFromToken();
  if (!user || typeof user !== "object") {
    return null;
  }
// COMMENT-TO-REPLACE
  return (user as { role?: string }).role ?? null;
}
// COMMENT-TO-REPLACE
export function isLoggedIn(): boolean {
  return Boolean(localStorage.getItem("token"));
}
// COMMENT-TO-REPLACE
</file>

