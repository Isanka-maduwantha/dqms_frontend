const VISIT_PURPOSES = [
    { value: "NEW_TREATMENT", label: "New treatment (billable)" },
    { value: "FOLLOW_UP", label: "Follow-up (no charge)" },
    { value: "CHECKUP", label: "Checkup (no charge)" },
