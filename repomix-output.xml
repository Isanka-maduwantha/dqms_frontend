        <FormInput label="NIC" value={form.nic} onChange={(e) => setForm((f) => ({ ...f, nic: e.target.value }))} required/>
        <FormInput label="Phone" value={form.phone} onChange={(e) => setForm((f) => ({ ...f, phone: e.target.value }))} required/>
